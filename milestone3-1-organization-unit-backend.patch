+        $unitId = UuidV7::generate();
+
+        DB::table('organization_units')->insert([
+            'id' => $unitId,
+            'tenant_id' => $tenantId,
+            'organization_id' => $organizationId,
+            'name' => $name,
+            'code' => $code,
+            'is_active' => true,
+            'created_at' => now(),
+            'updated_at' => now(),
+        ]);
+
+        return $unitId;
+    }
+}
